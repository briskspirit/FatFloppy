#!/bin/bash
# More portable version without associative arrays

# Exit immediately if a command exits with a non-zero status.
set -e

echo "Running tests in isolated processes..."

TEST_DIR="tests"
TEST_FILES=$(find "$TEST_DIR" -name 'test_*.py' | sort)

# Ensure TEST_HW is set if needed (or clear it for mocks)
# export TEST_HW=true # Uncomment for hardware tests
unset TEST_HW       # Ensure mocked tests run mocked

# Store overall result
all_passed=true
failed_files=""

for test_file in $TEST_FILES; do
  echo "-----------------------------------------------------"
  echo "RUNNING: $test_file"
  echo "-----------------------------------------------------"
  # Run the test file using the unittest module
  # Temporarily disable 'exit on error' to capture the result
  set +e
  python -m unittest -v "$test_file"
  exit_code=$?
  set -e # Re-enable exit on error

  if [ $exit_code -eq 0 ]; then
    echo "RESULT: $test_file -> PASSED"
  else
    echo "RESULT: $test_file -> FAILED (Exit Code: $exit_code)"
    all_passed=false
    failed_files="$failed_files $test_file"
    # break # Uncomment to stop on first failure
  fi
  echo ""
done

echo "====================================================="
echo "Isolated Test Run Summary:"
echo "====================================================="
if $all_passed; then
  echo "All test files PASSED when run in isolation."
  exit 0
else
  echo "One or more test files FAILED when run in isolation:"
  # Print the list of failed files
  for f in $failed_files; do
      echo "  - $f"
  done
  exit 1
fi
