#!/bin/bash

# Exit immediately if a command exits with a non-zero status.
set -e

# --- Configuration ---
GW="gw" # Path to gw executable, ensure it's in PATH
IMG_DIR="tests/resources" # Path to your master images
TEST_DIR="tests"          # Path to your tests directory

# Master Image Files (MUST BE CREATED MANUALLY)
EMPTY_144M="$IMG_DIR/empty_formatted_144m.img"
POPULATED_144M="$IMG_DIR/populated_read_test_144m.img"
EMPTY_360K="$IMG_DIR/empty_formatted_360k.img"
POPULATED_360K="$IMG_DIR/populated_read_test_360k.img"

# GW Format Names for Writing Images (Check gw diskdefs or use params)
# These tell gw how to interpret the raw image data when writing to the floppy
GW_FORMAT_144M="ibm.1440" # Usually correct for standard 1.44MB
# For 360KB, specify parameters if no built-in name exists or if writing on a 1.2MB drive
GW_FORMAT_360K="ibm.360" # Example: 360k MFM format params

# --- Check Prerequisites ---
command -v "$GW" >/dev/null 2>&1 || { echo >&2 "ERROR: '$GW' command not found. Install Greaseweazle host tools and ensure it's in PATH."; exit 1; }
if [ ! -f "$EMPTY_144M" ] || [ ! -f "$POPULATED_144M" ] || [ ! -f "$EMPTY_360K" ] || [ ! -f "$POPULATED_360K" ]; then
    echo "ERROR: One or more master image files not found in '$IMG_DIR'."
    echo "Please create:"
    echo "  - $EMPTY_144M (Empty, FAT12 formatted 1.44MB)"
    echo "  - $POPULATED_144M (Formatted 1.44MB with test files/dirs)"
    echo "  - $EMPTY_360K (Empty, FAT12 formatted 360KB)"
    echo "  - $POPULATED_360K (Formatted 360KB with test files/dirs)"
    exit 1
fi
if [ ! -d "$TEST_DIR" ]; then
    echo "ERROR: Tests directory '$TEST_DIR' not found."
    exit 1
fi

# --- Functions ---
prepare_disk() {
    local drive="$1"
    local image_file="$2"
    local gw_format="$3"
    local description="$4"
    echo ""
    echo "-----------------------------------------------------"
    echo " Preparing Drive $drive ($description)"
    echo "-----------------------------------------------------"
    echo " >>> Will write image: $image_file"
    echo " >>> Using GW format: $gw_format"
    if [ -z "${AUTO+x}" ]; then
        read -p " >>> Please insert the correct floppy into Drive $drive and press Enter..."
    fi
    if ! "$GW" write --drive="$drive" --format="$gw_format" "$image_file" --retries=3; then
        echo "ERROR: Failed to prepare Drive $drive with '$GW write'. Trying one more time..."
        sleep 2
        if ! "$GW" write --drive="$drive" --format="$gw_format" "$image_file" --retries=3; then
             echo "ERROR: Failed to prepare Drive $drive on second attempt. Aborting."
             exit 1
         fi
    fi
    echo "Drive $drive prepared successfully."
    sleep 1 # Pause for drive mechanics
}

run_test_file() {
    local test_file="$1"
    local drive="$2"
    local format_key="$3" # e.g., 1.44M or 360K
    local description="$4"
    echo ""
    echo "*****************************************************"
    echo " Running Test File: $test_file"
    echo " Target: Drive $drive ($description)"
    echo "*****************************************************"
    export TEST_HW=true
    export TEST_DRIVE="$drive"
    export TEST_FORMAT="$format_key"
    # export GW_DEVICE=... # Optional: Set specific GW device path if needed
    if python -m unittest "$test_file"; then
        echo "*** SUCCESS: $test_file ***"
    else
        echo "!!! FAILURE: $test_file !!!"
        # Decide if you want to stop on failure or continue
        # exit 1 # Stop script on first test file failure
    fi
    unset TEST_DRIVE TEST_FORMAT TEST_HW # Clean up env vars
    echo ""
}

# --- Main Execution ---
echo "====================================================="
echo "           Starting FATFloppy Hardware Tests         "
echo "====================================================="
echo "Ensure Greaseweazle is connected and drives are ready."

# --- Drive A (3.5" 1.44MB) Tests ---
prepare_disk A "$POPULATED_144M" "$GW_FORMAT_144M" "Populated 1.44MB for Read Tests"
run_test_file "$TEST_DIR/test_hw_drive_a_read.py" A "1.44M" "1.44MB Read Tests"

prepare_disk A "$EMPTY_144M" "$GW_FORMAT_144M" "Empty 1.44MB for Write Tests"
run_test_file "$TEST_DIR/test_hw_drive_a_write.py" A "1.44M" "1.44MB Write/Delete Tests"

# --- Drive B (5.25" 360KB) Tests ---
prepare_disk B "$POPULATED_360K" "$GW_FORMAT_360K" "Populated 360KB for Read Tests"
run_test_file "$TEST_DIR/test_hw_drive_b_read.py" B "360K" "360KB Read Tests"

prepare_disk B "$EMPTY_360K" "$GW_FORMAT_360K" "Empty 360KB for Write Tests"
run_test_file "$TEST_DIR/test_hw_drive_b_write.py" B "360K" "360KB Write/Delete Tests"

echo "====================================================="
echo "            Hardware Tests Completed                 "
echo "====================================================="

exit 0
